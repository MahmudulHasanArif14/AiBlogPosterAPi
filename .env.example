# --- Supabase -------------------------------------------------------------
# The project URL and publishable key are safe in the browser. The service-role
# key must stay server-only: it bypasses Row Level Security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET

# --- AI provider ----------------------------------------------------------
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Featured images ------------------------------------------------------
# Required. An article with no licence-checked image is held for review.
PEXELS_API_KEY=YOUR_PEXELS_KEY

# --- Scheduling and admin -------------------------------------------------
# Authenticates the Vercel cron trigger and every /api/admin route. Generate a
# long random value. It is not a staff login.
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# --- Site -----------------------------------------------------------------
# Absolute origin of this content hub. Used for canonical URLs, the sitemap,
# the RSS feed and the content_url returned by the API.
SITE_URL=https://content.westerncars.com

# Set to the literal string "true" to let articles that clear every quality and
# provenance check publish without review. Anything else keeps them as drafts.
AUTO_PUBLISH_ENABLED=false

# --- Content distribution -------------------------------------------------
# Where each location's website receives publication notifications, and the
# secret used to sign them. One pair per location, suffixed with the location
# slug uppercased and hyphens replaced by underscores:
#
#   brighton        -> ..._BRIGHTON
#   haywards-heath  -> ..._HAYWARDS_HEATH
#
# Both are server-only. Never give either a NEXT_PUBLIC_ prefix: that would
# inline the signing secret into the browser bundle and anyone could forge a
# revalidation request. A location with no pair set is skipped, which is the
# correct state for a location that has no website yet.
#
# The secret must be the same value as REVALIDATE_WEBHOOK_SECRET on the
# receiving website. Generate with: openssl rand -hex 32
DELIVERY_WEBHOOK_URL_BRIGHTON=https://YOUR_BRIGHTON_DOMAIN/api/revalidate-blog
DELIVERY_WEBHOOK_SECRET_BRIGHTON=GENERATE_A_LONG_RANDOM_SECRET

# Optional tuning. The defaults are sensible; these exist so a slow receiver
# can be accommodated without a code change.
# DELIVERY_TIMEOUT_MS=8000
# DELIVERY_BATCH_SIZE=10
# How far back the scheduled reconciler looks for published articles with no
# delivery row. Must stay well above the scheduler interval so a skipped or
# slow run cannot step over an article.
# RECONCILE_WINDOW_HOURS=48
# RECONCILE_BATCH_SIZE=25
